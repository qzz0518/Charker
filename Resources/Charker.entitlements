<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.device.bluetooth</key>
	<true/>
	<!-- Outgoing connections only: optional Anker sign-in plus the A2345
	     read-only HTTPS/MQTT subscription. There is deliberately no
	     network.server entitlement. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Sparkle's sandboxed installer launcher uses these two per-app Mach
	     services. This shell-assembled bundle has no Xcode substitution pass,
	     so the concrete bundle identifier must be written here. -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>dev.charker.Charker-spks</string>
		<string>dev.charker.Charker-spki</string>
	</array>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
