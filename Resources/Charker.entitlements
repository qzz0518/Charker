<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.device.bluetooth</key>
	<true/>
	<!-- Outgoing: optional Anker sign-in plus the A2345 HTTPS/MQTT cloud
	     connection. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Incoming: only the Apple Home (Matter) accessory, which listens on
	     UDP for the user's own Home, and only while it is turned on. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Sparkle's sandboxed installer launcher uses these two per-app Mach
	     services. This shell-assembled bundle has no Xcode substitution pass,
	     so the concrete bundle identifier must be written here. -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>dev.charker.Charker-spks</string>
		<string>dev.charker.Charker-spki</string>
	</array>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
