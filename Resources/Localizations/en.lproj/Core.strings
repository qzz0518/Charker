/* Session warnings and failures */
"在「%@」阶段未收到响应" = "No response during “%@”.";
"充电器拒绝了这个账号身份，之后不再返回数据。请在「设备与连接」里填入绑定这台充电器的 Anker 账号 ID。" = "The charger rejected this account identity and stopped returning data. Enter the ID of the Anker account bound to this charger under Devices & Connection.";
"会话已建立，但充电器对读取命令没有任何应答。" = "The session was established, but the charger did not respond to any read commands.";
"已扫描 %d 秒，附近没有任何蓝牙设备。请确认蓝牙已开启。" = "Scanned for %d s without finding any Bluetooth devices. Make sure Bluetooth is turned on.";
"已扫描 %d 秒，看到 1 台蓝牙设备但没有充电器。充电器被连接时会完全停止广播——请确认它已通电，且官方 Anker App 或另一台设备没有占用它。" = "Scanned for %d s and found 1 Bluetooth device, but no charger. The charger stops advertising while another device is connected—make sure it has power and is not in use by the official Anker app or another device.";
"已扫描 %d 秒，看到 %d 台蓝牙设备但没有充电器。充电器被连接时会完全停止广播——请确认它已通电，且官方 Anker App 或另一台设备没有占用它。" = "Scanned for %d s and found %d Bluetooth devices, but no charger. The charger stops advertising while another device is connected—make sure it has power and is not in use by the official Anker app or another device.";
"充电器拒绝了「%@」（状态码 0x%02X），正在尝试以只读方式继续。" = "The charger rejected \"%@\" with status 0x%02X. Charker is trying to continue in read-only mode.";
"握手失败（%@）：%@" = "Handshake failed (%@): %@";
"充电器拒绝了「%@」，状态码 0x%02X" = "The charger rejected “%@” with status 0x%02X";
"「%@」响应缺少字段 0x%02X" = "The “%@” response is missing field 0x%02X";
"会话密钥协商失败" = "Session key negotiation failed";
"握手时序异常（%@）" = "Unexpected handshake sequence (%@)";
